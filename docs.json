{
  "$schema": "https://mintlify.com/docs.json",
  "theme": "mint",
  "name": "FarmGPU",
  "colors": {
    "primary": "#88ff00",
    "light": "#a0ff33",
    "dark": "#529900"
  },
  "favicon": {
    "light": "/logo/fgpu_green.svg",
    "dark": "/logo/fgpu_white.svg"
  },
  "navigation": {
    "global": {
      "anchors": [
        {
          "anchor": "Documentation",
          "icon": "book-open-cover",
          "href": "/"
        },
        {
          "anchor": "Blog",
          "icon": "newspaper",
          "href": "https://blog.farmgpu.com"
        },
        {
          "anchor": "Calculator",
          "icon": "calculator",
          "href": "https://calculator.farmgpu.com"
        }
      ]
    },
    "tabs": [
      {
        "tab": "Company",
        "groups": [
          {
            "group": "Overview",
            "pages": [
              "index",
              "company-docs/company-overview/company-snapshot",
              "company-docs/company-overview/mission-vision-positioning",
              "company-docs/company-overview/founders-thesis"
            ]
          },
          {
            "group": "Products & Services",
            "pages": [
              "company-docs/products-services/index",
              "company-docs/products-services/partners"
            ]
          },
          {
            "group": "Technical Architecture",
            "pages": [
              "company-docs/technical-architecture/hardware-stack",
              "company-docs/technical-architecture/software-stack",
              "company-docs/technical-architecture/instant-clusters"
            ]
          },
          {
            "group": "Data Center & Operations",
            "pages": [
              "company-docs/data-center-operations/data-center-specifications",
              "company-docs/data-center-operations/monitoring-reliability"
            ]
          },
          {
            "group": "Security",
            "pages": [
              "company-docs/security/compliance-standards",
              "company-docs/security/storage-security",
              "company-docs/security/confidential-computing",
              "company-docs/security/linux-security-hardening"
            ]
          },
          {
            "group": "Legal & Policies",
            "pages": [
              "company-docs/legal/user-agreements-policies",
              "company-docs/legal/service-level-agreements",
              "company-docs/legal/privacy-policy",
              "company-docs/legal/data-retention-policy"
            ]
          },
          {
            "group": "Team & Culture",
            "pages": [
              "company-docs/team-culture/team-structure",
              "company-docs/team-culture/culture",
              "company-docs/team-culture/brand"
            ]
          }
        ]
      },
      {
        "tab": "Cloud API",
        "groups": [
          {
            "group": "Get started",
            "pages": [
              "api-reference/introduction",
              "api-reference/quickstart",
              "api-reference/authentication",
              "api-reference/operations-and-webhooks",
              "api-reference/errors-and-limits"
            ]
          },
          {
            "group": "Endpoints",
            "openapi": "api-reference/openapi.json",
            "pages": [
              {
                "group": "Instances",
                "pages": [
                  "POST /v1/instances",
                  "GET /v1/instances",
                  "GET /v1/instances/{instance_id}",
                  "PATCH /v1/instances/{instance_id}",
                  "DELETE /v1/instances/{instance_id}",
                  "POST /v1/instances/{instance_id}/actions",
                  "GET /v1/instances/{instance_id}/console",
                  "GET /v1/instances/{instance_id}/attestation",
                  "GET /v1/instances/{instance_id}/usage"
                ]
              },
              {
                "group": "Instance Types",
                "pages": [
                  "GET /v1/instance-types"
                ]
              },
              {
                "group": "Instance Availability",
                "pages": [
                  "GET /v1/instance-availability",
                  "GET /v1/instance-availability/{instance_type}"
                ]
              },
              {
                "group": "Regions",
                "pages": [
                  "GET /v1/regions"
                ]
              },
              {
                "group": "Images",
                "pages": [
                  "GET /v1/images"
                ]
              },
              {
                "group": "Volumes",
                "pages": [
                  "POST /v1/volumes",
                  "GET /v1/volumes",
                  "GET /v1/volumes/{volume_id}",
                  "DELETE /v1/volumes/{volume_id}",
                  "POST /v1/volumes/{volume_id}/restore",
                  "POST /v1/volumes/{volume_id}/attach",
                  "POST /v1/volumes/{volume_id}/detach",
                  "POST /v1/volumes/{volume_id}/resize",
                  "POST /v1/volumes/{volume_id}/clone"
                ]
              },
              {
                "group": "Filesystems",
                "pages": [
                  "POST /v1/filesystems",
                  "GET /v1/filesystems",
                  "GET /v1/filesystems/{filesystem_id}",
                  "DELETE /v1/filesystems/{filesystem_id}",
                  "POST /v1/filesystems/{filesystem_id}/resize"
                ]
              },
              {
                "group": "SSH Keys",
                "pages": [
                  "POST /v1/ssh-keys",
                  "GET /v1/ssh-keys",
                  "GET /v1/ssh-keys/{key_id}",
                  "DELETE /v1/ssh-keys/{key_id}"
                ]
              },
              {
                "group": "Startup Scripts",
                "pages": [
                  "POST /v1/startup-scripts",
                  "GET /v1/startup-scripts",
                  "GET /v1/startup-scripts/{script_id}",
                  "DELETE /v1/startup-scripts/{script_id}"
                ]
              },
              {
                "group": "Operations",
                "pages": [
                  "GET /v1/operations",
                  "GET /v1/operations/{operation_id}"
                ]
              },
              {
                "group": "Webhooks",
                "pages": [
                  "POST /v1/webhooks",
                  "GET /v1/webhooks",
                  "DELETE /v1/webhooks/{webhook_id}"
                ]
              },
              {
                "group": "Usage",
                "pages": [
                  "GET /v1/usage",
                  "GET /v1/balance"
                ]
              },
              {
                "group": "Quotas",
                "pages": [
                  "GET /v1/quotas"
                ]
              },
              {
                "group": "Attestation",
                "pages": [
                  "GET /v1/attestation/references"
                ]
              },
              {
                "group": "Auth",
                "pages": [
                  "POST /v1/auth/tokens",
                  "GET /v1/auth/tokens",
                  "DELETE /v1/auth/tokens/{token_id}"
                ]
              },
              {
                "group": "Health",
                "pages": [
                  "GET /health"
                ]
              }
            ]
          }
        ]
      }
    ]
  },
  "logo": {
    "light": "/logo/FarmGPU_Black_Full.svg",
    "dark": "/logo/FarmGPU_White_Full.svg",
    "href": "/"
  },
  "redirects": [
    {
      "source": "/company-docs/data-center-operations/service-level-agreements",
      "destination": "/company-docs/legal/service-level-agreements"
    },
    {
      "source": "/company-docs/data-center-operations/user-agreements-policies",
      "destination": "/company-docs/legal/user-agreements-policies"
    }
  ],
  "navbar": {
    "links": []
  },
  "contextual": {
    "options": [
      "copy",
      "view",
      "chatgpt",
      "claude",
      "perplexity",
      "mcp",
      "cursor",
      "vscode"
    ]
  },
  "footer": {
    "socials": {
      "x": "https://x.com/mintlify",
      "github": "https://github.com/mintlify",
      "linkedin": "https://linkedin.com/company/mintlify"
    }
  }
}
